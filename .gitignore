# --- Dataset: never committed (download instructions are in the README)
data/raw/*
!data/raw/.gitkeep

# --- Processed data: rebuilt by the scripts; only the fixed split is committed
data/processed/*
!data/processed/splits.csv

# --- Model weights and checkpoints (too large; host externally if needed)
outputs/checkpoints/
*.pt
*.pth

# --- Python and notebook clutter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# --- OS files
.DS_Store
Thumbs.db

# --- Archives (e.g. the dataset zip)
*.zip
